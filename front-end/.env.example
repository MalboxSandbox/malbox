# Base URL for the malbox-http back-end.
# Read only server-side by the SvelteKit proxy routes.
MALBOX_API_URL=http://127.0.0.1:8080

# Raise the SvelteKit body-size limit so large sample uploads go through.
# Default is 512 KiB — not enough for real malware samples.
# Set to 0 to disable the limit entirely.
BODY_SIZE_LIMIT=0
