  "query": "\n        SELECT id, task_id, plugin_name, result_name,\n               format AS \"format: ResultFormat\",\n               role   AS \"role: ResultRole\",\n               size_bytes, file_path, created_on\n        FROM task_results\n        WHERE task_id = $1 AND role = 'report'::task_result_role\n        ORDER BY created_on\n        ",
