{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "mint",
    "name": "Malbox Docs",
    "colors": {
        "primary": "#516cf9",
        "light": "#516cf9",
        "dark": "#516cf9"
    },
    "banner": {
        "content": "Documentation is still a work-in-progress! Some parts may be missing or incomplete.",
        "dismissible": true
    },
    "icons": { "library": "lucide" },
    "favicon": "/favicon.svg",
    "navigation": {
        "tabs": [
            {
                "tab": "Documentation",
                "groups": [
                    {
                        "group": "Getting Started",
                        "pages": ["index", "quickstart"]
                    },
                    {
                        "group": "Plugin System",
                        "pages": [
                            "plugin-system/overview",
                            "plugin-system/event-hooks",
                            "plugin-system/configuration"
                        ]
                    },
                    {
                        "group": "Machinery",
                        "pages": [
                            "machinery/providers",
                            "machinery/provisioners",
                            "machinery/packer"
                        ]
                    },
                    {
                        "group": "Task Management",
                        "pages": [
                            "task-management/scheduling",
                            "task-management/workers"
                        ]
                    },
                    {
                        "group": "Contributing",
                        "pages": [
                            "contributing/guidelines",
                            "contributing/dev-environment"
                        ]
                    }
                ]
            },
            {
                "tab": "Guides",
                "groups": [
                    {
                        "group": "Installation",
                        "pages": [
                            "installation/automatic",
                            "installation/manual"
                        ]
                    },
                    {
                        "group": "Plugin Development",
                        "pages": [
                            "plugin-guides/creating-a-rust-plugin",
                            "plugin-guides/creating-a-cpp-plugin",
                            "plugin-guides/creating-a-python-plugin"
                        ]
                    }
                ]
            },
{
                "tab": "Reference",
                "groups": [
                    {
                        "group": "CLI",
                        "pages": [
                            "reference/cli/malbox",
                            "reference/cli/malbox-daemon",
                            "reference/cli/malboxd"
                        ]
                    },
                    {
                        "group": "Configuration",
                        "pages": [
                            "reference/configuration/workers",
                            "reference/configuration/plugins"
                        ]
                    },
                    {
                        "group": "Plugin SDK",
                        "pages": [
                        "reference/plugin-sdk/sdk",
                        "reference/plugin-sdk/results",
                        "reference/plugin-sdk/events"
                    ]
                    }
                ]
            }
        ],
        "global": {
            "anchors": [
                {
                    "anchor": "Changelog",
                    "href": "/changelog",
                    "icon": "scroll-text"
                },
                {
                    "anchor": "Roadmap",
                    "href": "/roadmap",
                    "icon": "map"
                }
            ]
        }
    },
    "logo": {
        "light": "/logo/light.svg",
        "dark": "/logo/dark.svg"
    },
    "navbar": {
        "primary": {
            "type": "github",
            "label": "Malbox Repository",
            "href": "https://github.com/DualHorizon/malbox/"
        }
    },
    "contextual": {
        "options": ["copy", "view", "mcp"]
    },
    "footer": {
        "socials": {
            "x": "https://x.com/malbox_sandbox",
            "github": "https://github.com/DualHorizon/malbox/"
        }
    }
}
